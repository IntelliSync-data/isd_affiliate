<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_affiliate" model="ir.module.category">
        <field name="name">Affiliate</field>
        <field name="sequence">70</field>
    </record>

    <!-- Back office: sees every affiliate and their referred orders -->
    <record id="group_affiliate_manager" model="res.groups">
        <field name="name">Affiliate Manager</field>
        <field name="category_id" ref="module_category_affiliate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages affiliates, sources and approvals, and sees the orders they referred.</field>
    </record>

    <!-- The affiliates themselves: portal users, never inside /odoo -->
    <record id="group_affiliate_portal" model="res.groups">
        <field name="name">Affiliate (portal)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Given to affiliates who sign up. Their own page only, on /my/affiliate.</field>
    </record>
</odoo>
