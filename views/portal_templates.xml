<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The affiliate pages stand on their own: the site's look, without its header and footer -->
    <template id="affiliate_layout" name="Affiliate Page Layout">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="no_copyright" t-value="True"/>
            <t t-set="pageName" t-value="'o_isd_affiliate_page'"/>
            <t t-out="0"/>
        </t>
    </template>

    <!-- A centred card with the company logo, for signing in and up -->
    <template id="auth_card" name="Affiliate Sign-in Card">
        <t t-call="isd_affiliate.affiliate_layout">
            <div class="container py-5">
                <div class="card border-0 shadow-sm mx-auto o_isd_affiliate_card">
                    <div class="card-body p-4">
                        <img src="/web/binary/company_logo" alt="Logo" class="d-block mx-auto mb-3 o_isd_affiliate_logo"/>
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- /register-affiliate -->
    <template id="signup" name="Affiliate Sign-up">
        <t t-call="isd_affiliate.auth_card">
            <div class="o_isd_affiliate_signup">
                <h4 class="text-center mb-3">Become an affiliate</h4>
                <div t-if="closed" class="alert alert-info" role="status">
                    Affiliate sign-up is closed at the moment.
                </div>
                <form t-else="" method="post" action="/register-affiliate" class="oe_signup_form" role="form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                    <div class="mb-3">
                        <label for="isd_aff_name" class="form-label">Full name</label>
                        <input type="text" name="name" id="isd_aff_name" class="form-control" required="required"
                               autocomplete="name" t-att-value="name"/>
                    </div>
                    <div class="mb-3">
                        <label for="isd_aff_email" class="form-label">Email</label>
                        <input type="email" name="email" id="isd_aff_email" class="form-control" required="required"
                               autocomplete="email" autocapitalize="off" t-att-value="email"/>
                    </div>
                    <div class="mb-3">
                        <label for="isd_aff_phone" class="form-label">Phone</label>
                        <input type="tel" name="phone" id="isd_aff_phone" class="form-control" autocomplete="tel"
                               t-att-value="phone"/>
                    </div>
                    <div class="mb-3">
                        <label for="isd_aff_password" class="form-label">Password</label>
                        <input type="password" name="password" id="isd_aff_password" class="form-control"
                               required="required" minlength="8" autocomplete="new-password"/>
                    </div>
                    <div class="mb-3">
                        <label for="isd_aff_confirm" class="form-label">Confirm password</label>
                        <input type="password" name="confirm_password" id="isd_aff_confirm" class="form-control"
                               required="required" minlength="8" autocomplete="new-password"/>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" name="terms" id="isd_aff_terms" class="form-check-input" value="1"
                               required="required"/>
                        <label for="isd_aff_terms" class="form-check-label">I agree to the affiliate terms</label>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Sign up</button>
                    </div>
                </form>
                <div class="text-center small mt-3">
                    <a href="/login-affiliate">I already have an affiliate account</a>
                </div>
            </div>
        </t>
    </template>

    <!-- /login-affiliate -->
    <template id="login" name="Affiliate Sign-in">
        <t t-call="isd_affiliate.auth_card">
            <h4 class="text-center mb-3">Affiliate sign-in</h4>
            <form method="post" action="/login-affiliate" role="form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <div class="mb-3">
                    <label for="isd_aff_login" class="form-label">Email</label>
                    <input type="text" name="login" id="isd_aff_login" class="form-control" required="required"
                           autocomplete="username" autocapitalize="off" autofocus="autofocus" t-att-value="login"/>
                </div>
                <div class="mb-3">
                    <label for="isd_aff_login_password" class="form-label">Password</label>
                    <input type="password" name="password" id="isd_aff_login_password" class="form-control"
                           required="required" autocomplete="current-password"/>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Sign in</button>
                </div>
            </form>
            <div class="d-flex justify-content-between small mt-3">
                <a href="/web/reset_password">Forgot password?</a>
                <a t-if="signup_enabled" href="/register-affiliate">Become an affiliate</a>
            </div>
        </t>
    </template>

    <!-- The login page points to the sign-up while it is open -->
    <template id="login_affiliate_link" inherit_id="web.login" name="Affiliate sign-up link">
        <xpath expr="//form[@role='form']" position="after">
            <div t-if="request.env['res.partner'].sudo()._affiliate_signup_enabled()" class="text-center small mt-2">
                <a href="/register-affiliate">Become an affiliate</a>
            </div>
        </xpath>
    </template>

    <!-- A card on My Account, for affiliates -->
    <template id="portal_my_home_affiliate" inherit_id="portal.portal_my_home" name="Affiliate card">
        <div id="portal_client_category" position="inside">
            <t t-if="request.env.user.partner_id.is_affiliate" t-call="portal.portal_docs_entry">
                <t t-set="title">Affiliate</t>
                <t t-set="url" t-value="'/my-affiliate'"/>
                <t t-set="text">Your code, your referral links and the orders they brought</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <!-- /my-affiliate -->
    <template id="portal_my_affiliate" name="My Affiliate Page">
        <t t-call="isd_affiliate.affiliate_layout">
            <div class="container o_isd_affiliate_portal py-4">
                <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                    <img src="/web/binary/company_logo" alt="Logo" class="o_isd_affiliate_logo"/>
                    <div class="d-flex align-items-center gap-3 small">
                        <span class="text-muted d-none d-sm-inline" t-out="affiliate.email"/>
                        <!-- Hidden for now: /my/account still shows the site header and footer
                        <a href="/my/account" class="text-decoration-none">My details</a> -->
                        <a href="/web/session/logout?redirect=/login-affiliate" class="btn btn-sm btn-outline-secondary">Log out</a>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <h3 class="mb-0" t-out="affiliate.name"/>
                    <span t-if="affiliate.affiliate_state == 'approved'" class="badge text-bg-success">Approved</span>
                    <span t-elif="affiliate.affiliate_state == 'pending'" class="badge text-bg-warning">Waiting for approval</span>
                    <span t-else="" class="badge text-bg-danger">Rejected</span>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="text-muted small">Affiliate code</div>
                            <div class="fs-4 font-monospace o_isd_aff_code" t-out="affiliate.affiliate_code"/>
                        </div>
                        <div t-if="affiliate.affiliate_state == 'pending'" class="alert alert-warning mb-0">
                            Your account is waiting for approval. Your referral links appear here once it is approved.
                        </div>
                        <div t-elif="affiliate.affiliate_state == 'rejected'" class="alert alert-danger mb-0">
                            Your affiliate account was not approved. Please contact us for details.
                        </div>
                        <div t-elif="not default_link" class="alert alert-info mb-0">
                            Referral links are not ready yet. Please check back soon.
                        </div>
                        <div t-else="" class="o_isd_aff_links">
                            <label for="isd_aff_source" class="form-label">Referral link for</label>
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <img class="o_isd_aff_icon d-none" alt=""/>
                                <select id="isd_aff_source" class="form-select o_isd_aff_source">
                                    <option value="" t-att-data-url="default_link">General link</option>
                                    <t t-foreach="links" t-as="link">
                                        <option t-att-value="link['id']" t-att-data-url="link['url']"
                                                t-att-data-icon="'/affiliate/source-icon/%s' % link['id'] if link['icon'] else ''"
                                                t-out="link['name']"/>
                                    </t>
                                </select>
                            </div>
                            <div class="input-group">
                                <input type="text" readonly="readonly" class="form-control o_isd_aff_link"
                                       t-att-value="default_link" aria-label="Referral link"/>
                                <button type="button" class="btn btn-primary o_isd_aff_copy"
                                        data-copied-label="Copied">Copy</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-4">
                        <div class="card h-100"><div class="card-body">
                            <div class="text-muted small">Referred orders</div>
                            <div class="fs-4" t-out="order_count"/>
                        </div></div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="card h-100"><div class="card-body">
                            <div class="text-muted small">Paid orders total</div>
                            <div class="fs-4" t-out="paid_total" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                        </div></div>
                    </div>
                </div>

                <h5>Orders you referred</h5>
                <div t-if="not orders" class="text-muted">No orders yet. Share your link to get started.</div>
                <div t-else="" class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Product</th>
                                <th>Source</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="orders" t-as="order">
                                <td t-out="order['date']" t-options="{'widget': 'date'}"/>
                                <td t-out="order['product']"/>
                                <td t-out="order['source']"/>
                                <td class="text-end" t-out="order['amount']"
                                    t-options="{'widget': 'monetary', 'display_currency': order['currency']}"/>
                                <td>
                                    <span t-attf-class="badge #{'text-bg-success' if order['state'] == 'sale' else ('text-bg-secondary' if order['state'] == 'cancel' else 'text-bg-info')}"
                                          t-out="order['state_label']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
